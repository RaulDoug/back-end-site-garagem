{
  "name": "back-end-garagem",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "dev": "tsx --conditions development watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "imports": {
    "#services/*": {
      "types": "./src/services/*",
      "development": "./src/services/*",
      "default": "./dist/services/*"
    },
    "#controllers/*": {
      "types": "./src/controllers/*",
      "development": "./src/controllers/*",
      "default": "./dist/controllers/*"
    },
    "#routes/*": {
      "types": "./src/routes/*",
      "development": "./src/routes/*",
      "default": "./dist/routes/*"
    },
    "#middlewares/*": {
      "types": "./src/middlewares/*",
      "development": "./src/middlewares/*",
      "default": "./dist/middlewares/*"
    },
    "#repositories/*": {
      "types": "./src/repositories/*",
      "development": "./src/repositories/*",
      "default": "./dist/repositories/*"
    },
    "#schemas/*": {
      "types": "./src/schemas/*",
      "development": "./src/schemas/*",
      "default": "./dist/schemas/*"
    },
    "#utils/*": {
      "types": "./src/utils/*",
      "development": "./src/utils/*",
      "default": "./dist/utils/*"
    },
    "#src/*": {
      "types": "./src/*",
      "development": "./src/*",
      "default": "./dist/*"
    }
  }
}
