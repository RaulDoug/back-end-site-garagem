# Servidor
PORT=3000
NODE_ENV=development
# Quantidade de proxies reversos confiáveis na frente da aplicação (1 para Render/Northflank/Koyeb direto; 2 com Cloudflare Proxy na frente)
TRUST_PROXY_HOPS=1

# Banco de Dados (PostgreSQL no Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=garagem_db

# Autenticação
JWT_SECRET=seu_segredo_jwt_super_seguro
ONBOARDING_SECRET=sua_chave_secreta_de_provisionamento_saas
